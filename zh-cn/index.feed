\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"o\"\u003e[`\u003c/span\u003e\u003cspan class=\"nc\"\u003eA\u003c/span\u003e \u003cspan class=\"k\"\u003eof\u003c/span\u003e \u003cspan class=\"kt\"\u003eint\u003c/span\u003e \u003cspan class=\"o\"\u003e|\u003c/span\u003e \u003cspan class=\"o\"\u003e`\u003c/span\u003e\u003cspan class=\"nc\"\u003eB\u003c/span\u003e\u003cspan class=\"o\"\u003e]\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e所以，polymorphic variant 还是很灵活的，它的类型定义存在下面 3 种\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003ccode\u003e[ ... ]\u003c/code\u003e 表示\u003cem\u003e只有\u003c/em\u003e这些可能的 variant\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003e[\u0026gt; ... ]\u003c/code\u003e 表示有这些可能的 variant，但接受\u003cem\u003e更多\u003c/em\u003e的 variant\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003e[\u0026lt; ... ]\u003c/code\u003e 表示有这些可能的 variant，但\u003cem\u003e不接受\u003c/em\u003e再增加 variant\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 id=\"pattern-matching\" class=\"headerLink\"\u003e\n    \u003ca href=\"#pattern-matching\" class=\"header-mark\"\u003e\u003c/a\u003ePattern Matching\u003c/h2\u003e\u003cp\u003e如果函数入参是一个 polymorphic variant，我们可以尝试写一下 Pattern Matching 的函数，比如\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw:group tw:my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw:flex \n    tw:flex-row\n    tw:flex-1 \n    tw:justify-between \n    tw:w-full tw:bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw:mx-2 \n        tw:flex\n        tw:flex-row\n        tw:flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cspan class=\"tw:group-[.is-open]:rotate-90 tw:transition-[transform] tw:duration-500 tw:ease-in-out tw:print:hidden! tw:w-min tw:h-min tw:my-1 tw:mx-1\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512