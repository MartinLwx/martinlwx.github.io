\"\n      chroma \n      tw:block! \n      tw:p-0\n      tw:m-0\n      tw:transition-[max-height] \n      tw:duration-500 \n      tw:ease-in-out \n      tw:group-[.is-closed]:max-h-0! \n      tw:group-[.is-wrap]:text-wrap\n      tw:overflow-y-hidden\n      tw:overflow-x-auto\n      tw:scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"n\"\u003earr1\u003c/span\u003e \u003cspan class=\"o\"\u003e=\u003c/span\u003e \u003cspan class=\"p\"\u003e[]\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"n\"\u003earr2\u003c/span\u003e \u003cspan class=\"o\"\u003e=\u003c/span\u003e \u003cspan class=\"p\"\u003e[\u003c/span\u003e\u003cspan class=\"mi\"\u003e1\u003c/span\u003e\u003cspan class=\"p\"\u003e]\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"n\"\u003earr3\u003c/span\u003e \u003cspan class=\"o\"\u003e=\u003c/span\u003e \u003cspan class=\"p\"\u003e[\u003c/span\u003e\u003cspan class=\"mi\"\u003e1\u003c/span\u003e\u003cspan class=\"p\"\u003e,\u003c/span\u003e \u003cspan class=\"mi\"\u003e2\u003c/span\u003e\u003cspan class=\"p\"\u003e]\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e我们想要提取每个这样的列表里面的数字，但可能有 0 个，也可能有任意个，这\u003cstrong\u003e恰恰\u003c/strong\u003e是正则表达式里面的 \u003ccode\u003e*\u003c/code\u003e 的用法，因此我们可以写出如下的 Query\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw:group tw:my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw:flex \n    tw:flex-row\n    tw:flex-1 \n    tw:justify-between \n    tw:w-full tw:bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw:mx-2 \n        tw:flex\n        tw:flex-row\n        tw:flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cspan class=\"tw:group-[.