icense - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M16 132h416c8.837 0 16-7.163 16-16V76c0-8.837-7.163-16-16-16H16C7.163 60 0 67.163 0 76v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n      \n      \u003cbutton \n        class=\"\n          copy-code-button\n          tw:select-none\n          tw:mx-2 \n          tw:hidden\n          tw:group-[.is-open]:block\n          tw:hover:text-fgColor-link \n          tw:print:hidden!\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw:block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw:hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw:select-none \n          tw:mx-2 \n          tw:block \n          tw:group-[.is-open]:hidden \n          tw:print:hidden!\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw:block tw:m-0 tw:p-0\"\u003e\u003ccode \n    id=\"codeblock-id-1\" \n    class=\"\n      chroma \n      tw:block! \n      tw:p-0\n      tw:m-0\n      tw:transition-[max-height] \n      tw:duration-500 \n      tw:ease-in-out \n      tw:group-[.is-closed]:max-h-0! \n      tw:group-[.is-wrap]:text-wrap\n      tw:overflow-y-hidden\n      tw:overflow-x-auto\n      tw:scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"o\"\u003e==\u003c/span\u003e\u0026gt; Downloading https://downloads.sourceforge.net/qbittorrent/qbittorrent-mac/qbittorrent-4.3.9/qbittorrent-4.3.9.dmg\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003ecurl: \u003cspan class=\"o\"\u003e(\u003c/span\u003e35\u003cspan class=\"o\"\u003e)\u003c/span\u003e error:06FFF089:digital envelope routines:CRYPTO_internal:bad key \u003cspan class=\"nv\"\u003elength\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003e\u003cspan class=\"c1\"\u003e#   #   #\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eError: Download failed on Cask \u003cspan class=\"s1\"\u003e\u0026#39;qbittorrent\u0026#39;\u003c/span\u003e with message: Download failed: https://downloads.sourceforge.net/qbittorrent/qbittorrent-mac/qbittorrent-4.3.9/qbittorrent-4.3.9.dmg\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e此时我就想到要不干脆把这个文件下载下来, 然后用 homebrew 本地安装(应该是有这个功能的), 做了一番检索之后, 终于知道要怎么弄了, 下面我将以 qbittorrent-4.3.9.dmg 为例\u003c/p\u003e\n\u003ch2 id=\"step-1-获取路径文件名\" class=\"headerLink\"\u003e\n    \u003ca href=\"#step-1-%e8%8e%b7%e5%8f%96%e8%b7%af%e5%be%84%e6%96%87%e4%bb%b6%e5%90%8d\" class=\"header-mark\"\u003e\u003c/a\u003eStep 1. 获取路径文件名\u003c/h2\u003e\u003chr\u003e\n\u003cp\u003e可以先运行 \u003ccode\u003ebrew --cache\u003c/code\u003e 查看 homebrew 的缓存路径, 一般来说应该是在 \u003ccode\u003e~/Library/Caches/Homebrew\u003c/code\u003e 下.\u003c/p\u003e\n\u003cp\u003ehomebrew 会把安装包下载到里面的 \u003ccode\u003edownloads\u003c/code\u003e 文件夹里面, 也就是在 \u003ccode\u003e~/Library/Caches/Homebrew/downloads\u003c/code\u003e 下, 进入这个文件夹可以发现里面的文件名的格式都是 \u003ccode\u003e\u0026lt;url-hash\u0026gt;--\u0026lt;formula\u0026gt;-\u0026lt;version\u0026gt;\u003c/code\u003e, 显然, 我们也要把我们的安装包弄成这种格式放在里面.\u003c/p\u003e\n\u003cblockquote\u003e\n  \u003cp\u003e📒 使用 \u003ccode\u003ebrew --cache -s \u0026lt;formula\u0026gt;\u003c/code\u003e 来获取对应的路径文件名\u003c/p\u003e\n\n\u003c/blockquote\u003e\u003cp\u003e对应我们这篇文章的例子就是 \u003ccode\u003ebrew --cache -s qbittorrent\u003c/code\u003e, 可以看到输出内容是 \u003ccode\u003e/Users/\u0026lt;对应你的用户名\u0026gt;/Library/Caches/Homebrew/downloads/7ee479ba2a19cf904e4c415805a6adaead76e7c191d595c016c86b72044c22fa--qbittorrent-4.3.9.dmg\u003c/code\u003e\u003c/p\u003e\n\u003ch2 id=\"step-2-移动本地安装包到对应的目录下\" class=\"headerLink\"\u003e\n    \u003ca href=\"#step-2-%e7%a7%bb%e5%8a%a8%e6%9c%ac%e5%9c%b0%e5%ae%89%e8%a3%85%e5%8c%85%e5%88%b0%e5%af%b9%e5%ba%94%e7%9a%84%e7%9b%ae%e5%bd%95%e4%b8%8b\" class=\"header-mark\"\u003e\u003c/a\u003eStep 2. 移动本地安装包到对应的目录下\u003c/h2\u003e\u003chr\u003e\n\u003cp\u003e在 Step 1. 中我们已经可以知道该把文件放到什么地方, 接下来要做的无非就是移动文件可以, 如果打开文件浏览器移动那就慢了, 直接在命令行输入对应命令即可\u003c/p\u003e\n\u003cblockquote\u003e\n  \u003cp\u003e📒 使用 \u003ccode\u003emv \u0026lt;local-file\u0026gt; \u0026quot;$(brew --cache -s \u0026lt;formula\u0026gt;)\u0026quot;\u003c/code\u003e 移动本地安装包到对应目录下\u003c/p\u003e\n\n\u003c/blockquote\u003e\u003cp\u003e对应我们的例子就是 \u003ccode\u003emv qbittorrent-4.3.9.dmg  \u0026quot;$(brew --cache -s qbittorrent)\u0026quot;\u003c/code\u003e\u003c/p\u003e\n\u003ch2 id=\"step-3-再次运行-brew-install\" class=\"headerLink\"\u003e\n    \u003ca href=\"#step-3-%e5%86%8d%e6%ac%a1%e8%bf%90%e8%a1%8c-brew-install\" class=\"header-mark\"\u003e\u003c/a\u003eStep 3. 再次运行 \u003ccode\u003ebrew install\u003c/code\u003e\u003c/h2\u003e\u003chr\u003e\n\u003cp\u003e此时再次运行 \u003ccode\u003ebrew install qbittorrent\u003c/code\u003e 即可, 可以看到命令行找到了缓存文件\u0026#x1f917;, 而且安装成功了\u003c/p\u003e\n\u003cblockquote\u003e\n  \u003cp\u003e📒 再次运行 \u003ccode\u003ebrew install \u0026lt;formula\u0026gt;\u003c/code\u003e\u003c/p\u003e\n\n\u003c/blockquote\u003e\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw:group tw:my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw:flex \n    tw:flex-row\n    tw:flex-1 \n    tw:justify-between \n    tw:w-full tw:bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw:mx-2 \n        tw:flex\n        tw:flex-row\n        tw:flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cspan class=\"tw:group-[.is-open]:rotate-90 tw:transition-[transform] tw:duration-500 tw:ease-in-out tw:print:hidden! tw:w-min tw:h-min tw:my-1 tw:mx-1\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"tw:select-none tw:my-1! tw:block\"\u003ebash\u003c/span\u003e\n      \u003c/button\u003e\n\n   \u003cdiv class=\"tw:flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw:mx-2 \n          tw:hidden \n          tw:group-[.is-open]:block \n          tw:group-[.show-line-numbers]:text-fgColor-link \n          tw:print:hidden!\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M61.77 401l17.5-20.15a19.92 19.92 0 0 0 5.07-14.19v-3.31C84.34 356 80.5 352 73 352H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h22.83a157.41 157.41 0 0 0-11 12.31l-5.61 7c-4 5.07-5.25 10.13-2.8 14.88l1.05 1.93c3 5.76 6.29 7.88 12.25 7.88h4.73c10.33 0 15.94 2.44 15.94 9.09 0 4.72-4.2 8.22-14.36 8.22a41.54 41.54 0 0 1-15.47-3.12c-6.49-3.88-11.74-3.5-15.6 3.12l-5.59 9.31c-3.72 6.13-3.19 11.72 2.63 15.94 7.71 4.69 20.38 9.44 37 9.44 34.16 0 48.