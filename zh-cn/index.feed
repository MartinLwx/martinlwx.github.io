mi\"\u003e3\u003c/span\u003e\u003cspan class=\"p\"\u003e]],\u003c/span\u003e \u003cspan class=\"p\"\u003e[\u003c/span\u003e\u003cspan class=\"n\"\u003eBoW_matrix\u003c/span\u003e\u003cspan class=\"p\"\u003e[\u003c/span\u003e\u003cspan class=\"mi\"\u003e1\u003c/span\u003e\u003cspan class=\"p\"\u003e]]),\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"n\"\u003ecosine_similarity\u003c/span\u003e\u003cspan class=\"p\"\u003e([\u003c/span\u003e\u003cspan class=\"n\"\u003eBoW_matrix\u003c/span\u003e\u003cspan class=\"p\"\u003e[\u003c/span\u003e\u003cspan class=\"mi\"\u003e3\u003c/span\u003e\u003cspan class=\"p\"\u003e]],\u003c/span\u003e \u003cspan class=\"p\"\u003e[\u003c/span\u003e\u003cspan class=\"n\"\u003eBoW_matrix\u003c/span\u003e\u003cspan class=\"p\"\u003e[\u003c/span\u003e\u003cspan class=\"mi\"\u003e2\u003c/span\u003e\u003cspan class=\"p\"\u003e]]),\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"p\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cpre\u003e\u003ccode\u003e[[1.]] [[0.63245553]] [[0.2236068]]\n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003e🤔️ 机器也看出来了\u003c/p\u003e\n\u003ch2 id=\"更复杂的真实数据集\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%9b%b4%e5%a4%8d%e6%9d%82%e7%9a%84%e7%9c%9f%e5%ae%9e%e6%95%b0%e6%8d%ae%e9%9b%86\" class=\"header-mark\"\u003e\u003c/a\u003e更复杂的真实数据集\u003c/h2\u003e\u003cp\u003e前面的例子太简单了，下面我会用一个更复杂的真实数据集 —— \u003ca href=\"https://huggingface.co/datasets/code_search_net\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eCodeSearchNet\u003c/a\u003e。它包含了许多编程语言的函数，这里我挑 Python 来展示\u003c/p\u003e\n\u003cp\u003e当然你也可以选择你感兴趣的编程语言 :)\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw:group tw:my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw:flex \n    tw:flex-row\n    t