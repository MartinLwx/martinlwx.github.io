51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw:hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw:select-none \n          tw:mx-2 \n          tw:block \n          tw:group-[.is-open]:hidden \n          tw:print:hidden!\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw:block tw:m-0 tw:p-0\"\u003e\u003ccode \n    id=\"codeblock-id-36\" \n    class=\"\n      chroma \n      tw:block! \n      tw:p-0\n      tw:m-0\n      tw:transition-[max-height] \n      tw:duration-500 \n      tw:ease-in-out \n      tw:group-[.is-closed]:max-h-0! \n      tw:group-[.is-wrap]:text-wrap\n      tw:overflow-y-hidden\n      tw:overflow-x-auto\n      tw:scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003elines: line (newline line)* | line newline | line\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eline: word (\u0026#34;,\u0026#34; word)*\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eword: WORD | \n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003enewline: \u0026#34;\\n\u0026#34;\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e%import common.WORD\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "Hw10 题解 (UCB CS61A@2021 Fall)",
        "date_published" : "2022-03-02T13:36:13+08:00",
        "date_modified" : "2024-01-29T13:36:13+08:00",
        "id" : "https://martinlwx.github.io/zh-cn/hw10-of-cs61a-of-ucb/",
        "url" : "https://martinlwx.github.io/zh-cn/hw10-of-cs61a-of-ucb/",
        "summary": " BNF Q1: Grouping and Pipes In this question, you will add support for grouping and piping.\nRecall that grouping allows for an entire regular expression to be treated as a single unit, and piping allows for a pattern to match an expression on either side. Combined, these will let us create patterns which match multiple strings!\nDefine the group and pipe expressions in your grammar.\nA group consists of any regex expression surrounded by parentheses (()). A pipe operator consists of a regex expression, followed by a pipe (|) character, and lastly followed by another regex expression. For example, r\u0026quot;apples\u0026quot; would match exactly the phrase \u0026ldquo;apples\u0026rdquo; in an input. If we wanted our pattern from before to match \u0026ldquo;oranges\u0026rdquo; as well, we could expand our rstring to do so using groupings and pipes: r\u0026quot;(apples)|(oranges)\u0026quot;.\n",
        "author" : {
          "name" : "MartinLwx"
        },
        "content_html" : "\u003ch2 id=\"bnf\" class=\"headerLink\"\u003e\n    \u003ca href=\"#bnf\" class=\"header-mark\"\u003e\u003c/a\u003eBNF\u003c/h2\u003e\u003chr\u003e\n\u003ch3 id=\"q1-grouping-and-pipes\" class=\"headerLink\"\u003e\n    \u003ca href=\"#q1-grouping-and-pipes\" class=\"header-mark\"\u003e\u003c/a\u003eQ1: Grouping and Pipes\u003c/h3\u003e\u003cblockquote\u003e\n  \u003cp\u003eIn this question, you will add support for grouping and piping.\u003c/p\u003e\n\u003cp\u003eRecall that grouping allows for an entire regular expression to be treated as a single unit, and piping allows for a pattern to match an expression on either side. Combined, these will let us create patterns which match multiple strings!\u003c/p\u003e\n\u003cp\u003eDefine the \u003ccode\u003egroup\u003c/code\u003e and \u003ccode\u003epipe\u003c/code\u003e expressions in your grammar.\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eA \u003cstrong\u003e\u003ccode\u003egroup\u003c/code\u003e\u003c/strong\u003e consists of any \u003ccode\u003eregex\u003c/code\u003e expression surrounded by parentheses (\u003ccode\u003e()\u003c/code\u003e).\u003c/li\u003e\n\u003cli\u003eA \u003cstrong\u003e\u003ccode\u003epipe\u003c/code\u003e\u003c/strong\u003e operator consists of a \u003ccode\u003eregex\u003c/code\u003e expression, followed by a pipe (\u003ccode\u003e|\u003c/code\u003e) character, and lastly followed by another \u003ccode\u003eregex\u003c/code\u003e expression.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eFor example, \u003ccode\u003er\u0026quot;apples\u0026quot;\u003c/code\u003e would match exactly the phrase \u0026ldquo;apples\u0026rdquo; in an input. If we wanted our pattern from before to match \u0026ldquo;oranges\u0026rdquo; as well, we could expand our \u003ccode\u003erstring\u003c/code\u003e to do so using groupings and pipes: \u003ccode\u003er\u0026quot;(apples)|(oranges)\u0026quot;\u003c/code\u003e.\u003c/p\u003e\n\u003cblockquote\u003e\n  \u003cp\u003eHint: note that \u003ccode\u003egroup\u003c/code\u003es and \u003ccode\u003epipe\u003c/code\u003es are valid \u003ccode\u003eregex\u003c/code\u003e expressions on their own! You may need to update a previously defined expression.\u003c/p\u003e\n\n\u003c/blockquote\u003e\n\u003c/blockquote\u003e\u003cp\u003e给本来用来匹配正则表达式的 BNF 添加功能: \u003ccode\u003egroup\u003c/code\u003e 和 \u003ccode\u003epipe\u003c/code\u003e. 其实怎么实现这一写已经在描述里面给出了, 我这里就提一点: \u003ccode\u003egroup\u003c/code\u003e 和 \u003ccode\u003epipe\u003c/code\u003e 本身也是 \u003ccode\u003e?regex\u003c/code\u003e 的一部分, 所以要把他们加到 \u003ccode\u003e?regex\u003c/code\u003e 里面\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw:group tw:my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw:flex \n    tw:flex-row\n    tw:flex-1 \n    tw:justify-between \n    tw:w-full tw:bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw:mx-2 \n        tw:flex\n        tw:flex-row\n        tw:flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cspan class=\"tw:group-[.is-open]:rotate-90 tw:transition-[transform] tw:duration-500 tw:ease-in-out tw:print:hidden! tw:w-min tw:h-min tw:my-1 tw:mx-1\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"tw:select-none tw:my-1! tw:block\"\u003etext\u003c/span\u003e\n      \u003c/button\u003e\n\n   \u003cdiv class=\"tw:flex\"\u003e\n  